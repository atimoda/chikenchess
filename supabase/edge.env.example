# Local Edge-only file: copy to supabase/.env.local, never to the frontend.
# Hosted Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically. Never put the service key in NEXT_PUBLIC.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Exact browser origins, comma separated (production + intentional previews).
ONLINE_ALLOWED_ORIGINS=http://localhost:3000
