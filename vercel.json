{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/chicken-voice-simulator/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/chicken-voice-simulator",
      "destination": "/chicken-voice-simulator/?mode=bestiary&creature=chicken",
      "permanent": false
    },
    {
      "source": "/chicken-voice-simulator/",
      "missing": [
        {
          "type": "query",
          "key": "mode"
        }
      ],
      "destination": "/chicken-voice-simulator/?mode=bestiary&creature=chicken",
      "permanent": false
    }
  ]
}
